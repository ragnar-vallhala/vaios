
#
# Target Platform Configuration
#
CONFIG_ARCH_CORTEX_M4=y
# CONFIG_ARCH_AVR8 is not set
CONFIG_CMAKE_SYSTEM_PROCESSOR="cortex-m4"
CONFIG_ARCH_ISA="armv7e-m"
CONFIG_VENDOR_STM32=y
CONFIG_VENDOR="stm32"
CONFIG_FAMILY_STM32F4=y
CONFIG_FAMILY="stm32f4"
CONFIG_BOARD_NUCLEO_F401RE=y
CONFIG_BOARD="nucleo_f401re"
# end of Target Platform Configuration

#
# System & Features Configuration
#
CONFIG_USE_FPU=y
CONFIG_DRV_DMA=y
# CONFIG_DRV_CRC is not set
CONFIG_DRV_MPU=y
CONFIG_DRV_DWT=y
CONFIG_DRV_FPU=y
# end of System & Features Configuration

#
# HAL Drivers Configuration
#
CONFIG_DRV_CLOCK=y
CONFIG_DRV_INTERRUPT=y
CONFIG_DRV_GPIO=y
CONFIG_DRV_TIMER=y
CONFIG_DRV_UART=y
CONFIG_DRV_UART_DMA=y
# CONFIG_DRV_I2C is not set
# CONFIG_DRV_SPI is not set
# CONFIG_DRV_PWM is not set
CONFIG_DRV_SDIO=y
# CONFIG_DRV_FLASH is not set
# end of HAL Drivers Configuration

#
# Build Options
#
CONFIG_TOOLCHAIN_PREFIX="arm-none-eabi-"
# CONFIG_STANDALONE is not set
CONFIG_SAMPLE_NONE=y
# CONFIG_SAMPLE_00_TEST_SAMPLE is not set
# CONFIG_SAMPLE_01_HAL_BLINK is not set
# CONFIG_SAMPLE_01_NO_HAL_BLINK is not set
# CONFIG_SAMPLE_02_HAL_PUPD is not set
# CONFIG_SAMPLE_03_HAL_UART_TX is not set
# CONFIG_SAMPLE_03_NO_HAL_UART_TX is not set
# CONFIG_SAMPLE_04_HAL_TIMER is not set
# CONFIG_SAMPLE_05_HAL_SYSTICK is not set
# CONFIG_SAMPLE_06_HAL_BLINK_DELAY is not set
# CONFIG_SAMPLE_07_HAL_PWM is not set
# CONFIG_SAMPLE_08_NO_HAL_PWM is not set
# CONFIG_SAMPLE_09_HAL_CLOCK is not set
# CONFIG_SAMPLE_10_NO_HAL_I2C is not set
# CONFIG_SAMPLE_11_HAL_I2C is not set
# CONFIG_SAMPLE_12_NO_HAL_FLASH is not set
# CONFIG_SAMPLE_13_HAL_FLASH is not set
# CONFIG_SAMPLE_14_HAL_UART_INT is not set
# CONFIG_SAMPLE_15_HAL_UART_DMA is not set
# CONFIG_SAMPLE_16_HAL_DMA_POLLING_UART is not set
# CONFIG_SAMPLE_17_HAL_FPU is not set
# CONFIG_SAMPLE_18_HAL_CRC is not set
# CONFIG_SAMPLE_19_HAL_DMA_I2C is not set
# CONFIG_SAMPLE_20_HAL_SDIO is not set
# CONFIG_SAMPLE_21_HAL_SDIO_BLOCK is not set
# CONFIG_SAMPLE_22_HAL_FATFS_POSIX is not set
# CONFIG_SAMPLE_23_HAL_SDIO_PERF is not set
# CONFIG_SAMPLE_24_HAL_UART_DMA_BRIDGE is not set
# CONFIG_SAMPLE_25_HAL_SPI_ESP_BRIDGE is not set
# CONFIG_SAMPLE_26_HAL_DWT is not set
CONFIG_SAMPLE=""
# CONFIG_TEST is not set
CONFIG_FLASHER="st-flash"
CONFIG_FLASH_ADDRESS="0x8000000"
# end of Build Options
