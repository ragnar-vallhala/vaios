# What vaios needs from NavHAL, and nothing else.
#
# nav unions every line below into a consuming app's .config, and fails the
# build if the app's .config disagrees, so this file is the price of using vaios
# as a library: keep it to what vaios cannot link or boot without. It also seeds
# vaios's own standalone build (CMakeLists.txt); everything that build adds for
# itself -- the board, FatFs long names, the RTC, ... -- lives in defconfig.
#
# Module-conditional needs are not here. vaios checks them where the module is
# built and says which symbol is missing (see docs/consumer-interface.md):
#   VAIOS_MODULE_VFS   -> CONFIG_DRV_SDIO   (the FatFs/SDIO backend, v_open ...)
#   VAIOS_MPU_ENABLE   -> CONFIG_DRV_MPU    (hal_mpu_*)
# Optional capabilities vaios uses when present: DRV_RTC (`date`), DRV_DWT (perf
# cycle counts), DRV_USB_CDC, DRV_I2C, DRV_SPI, DRV_UART_DMA / DRV_DMA (buffered
# console), FS_LFN (long names, sizes VFS_NAME_MAX).

# Core: the boot path and the console. port_hw.c calls hal_clock_init,
# hal_timebase_init (the kernel tick), hal_interrupt_* (SysTick/PendSV/SVC
# priorities, IRQ attach) and hal_uart_* (the console); the UART driver pulls in
# GPIO for its pins.
CONFIG_DRV_CLOCK=y
CONFIG_DRV_INTERRUPT=y
CONFIG_DRV_GPIO=y
CONFIG_DRV_TIMER=y
CONFIG_DRV_UART=y

# The float ABI is NOT here: the app chooses it. vaios derives its own from the
# app's CONFIG_USE_FPU (VAIOS_FPU mirrors it, see the top-level CMakeLists.txt) and
# stops the build if that and NavHAL's USE_FPU disagree. A hard-float app states
# CONFIG_USE_FPU=y and CONFIG_DRV_FPU=y; a soft-float one states neither. The
# standalone build is hard-float, from defconfig.
