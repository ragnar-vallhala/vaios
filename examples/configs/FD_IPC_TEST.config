# Per-example Kconfig config for -DVAIOS_EXAMPLE=FD_IPC_TEST.
#
# fd-typed IPC (named semaphores on the per-task fd table) needs its whole
# dependency closure enabled — Kconfig chains them:
#     VAIOS_IPC_FD -> VAIOS_DEVFS -> VAIOS_SYSCALL_SVC -> VAIOS_MPU_ENABLE
# so all four are listed explicitly (kconfiglib keeps IPC_FD invisible until its
# deps are satisfied). Auto-selected by the top-level CMakeLists from the example
# name; override with -DVAIOS_CONFIG=<path>.
CONFIG_VAIOS_MPU_ENABLE=y
CONFIG_VAIOS_SYSCALL_SVC=y
CONFIG_VAIOS_DEVFS=y
CONFIG_VAIOS_IPC_FD=y
