# Per-example Kconfig config for -DVAIOS_EXAMPLE=DEVFS_TEST.
#
# The devfs test drives /dev/console through the file syscalls (v_file_open/
# write/close), which need the device-file model on. Kconfig chains it:
#     VAIOS_DEVFS -> VAIOS_SYSCALL_SVC -> VAIOS_MPU_ENABLE
# Auto-selected by the top-level CMakeLists; override with -DVAIOS_CONFIG=<path>.
CONFIG_VAIOS_MPU_ENABLE=y
CONFIG_VAIOS_SYSCALL_SVC=y
CONFIG_VAIOS_DEVFS=y
