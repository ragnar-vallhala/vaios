# Per-example Kconfig config for -DVAIOS_EXAMPLE=FD_WAIT_TEST.
#
# Multi-fd v_wait rides the same fd-typed IPC stack, so it needs the same
# dependency closure enabled:
#     VAIOS_IPC_FD -> VAIOS_DEVFS -> VAIOS_SYSCALL_SVC -> VAIOS_MPU_ENABLE
# Auto-selected by the top-level CMakeLists from the example name; override with
# -DVAIOS_CONFIG=<path>.
CONFIG_VAIOS_MPU_ENABLE=y
CONFIG_VAIOS_SYSCALL_SVC=y
CONFIG_VAIOS_DEVFS=y
CONFIG_VAIOS_IPC_FD=y
