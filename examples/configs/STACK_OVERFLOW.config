# Per-example Kconfig config for -DVAIOS_EXAMPLE=STACK_OVERFLOW.
#
# Deep recursion overruns the task stack. With the MPU stack-guard region armed
# the overrun trips a MemManage fault at the guard (clean, reported) instead of
# silently corrupting RAM. VAIOS_MPU_STACK_GUARD defaults y under MPU_ENABLE.
# Auto-selected by CMakeLists; override with -DVAIOS_CONFIG=<path>.
CONFIG_VAIOS_MPU_ENABLE=y
