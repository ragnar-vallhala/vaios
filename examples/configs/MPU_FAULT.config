# Per-example Kconfig config for -DVAIOS_EXAMPLE=MPU_FAULT.
#
# Phase-2 MPU positive tests: each probe deliberately faults against an armed
# MPU region (and merely warns/returns if the MPU is off). So the MPU must be
# enabled for the probe to demonstrate anything. VAIOS_MPU_STACK_GUARD defaults
# y under MPU_ENABLE. Auto-selected by CMakeLists; override with -DVAIOS_CONFIG.
CONFIG_VAIOS_MPU_ENABLE=y
