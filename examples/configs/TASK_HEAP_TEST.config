# Per-example Kconfig config for -DVAIOS_EXAMPLE=TASK_HEAP_TEST.
#
# Enables the per-task heap so the example's malloc/free/calloc/realloc bind to
# the task's own region (the low end of its stack block). Everything else stays
# at Kconfig defaults. Auto-selected by the top-level CMakeLists from the example
# name; override with -DVAIOS_CONFIG=<path>.
CONFIG_VAIOS_TASK_HEAP=y
