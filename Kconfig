config VAIOS_MODULE_TERMINAL
    bool "Interactive command terminal"
    default y
config VAIOS_MODULE_VFS
    bool "Virtual file system (FatFs/SDIO, needs NavHAL)"
    default n
config VAIOS_MODULE_SEMIHOSTING
