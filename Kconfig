    bool "SPSC/MPMC FIFO data structures"
    default y
config VAIOS_MODULE_PERF
    bool "Kernel performance counters"
    default y
endmenu

menu "Scheduling"
config MAX_TASK_PRIORITY
    int "Highest usable task priority"
    default 7
config IDLE_TASK_PRIORITY
    int "Idle task priority"
    default 0
config IDLE_TASK_STACK_SIZE
    int "Idle task stack size (bytes)"
    default 512
config TIME_SLICE
    int "Round-robin time slice (ticks)"
    default 2
config MAIN_STACK_SIZE
    int "Main/MSP stack size (bytes)"
    default 1024
config STACK_ALIGN_SIZE
    int "Task stack alignment (bytes)"
    default 8
config TASK_STACK_WATERMARK_ENABLE
    bool "Software stack-overflow watermark check"
    default y
config TASK_STACK_OVERFLOW_THRESHOLD
    int "Stack-overflow guard threshold (bytes)"
    default 64
endmenu

menu "Memory / Heap"
config HEAP_SIZE
    hex "Kernel heap size (bytes)"
    default 0x16000
config HEAP_WATERMARK_ENABLE
    bool "Panic when heap usage crosses the watermark"
    default y
config HEAP_WATERMARK_THRESHOLD
    int "Heap watermark headroom (bytes)"
    default 1024
config DMA_MIN_THRESHOLD
    int "Minimum transfer size to use DMA (bytes)"
    default 16
choice
    prompt "Heap allocator"
    default VAIOS_HEAP_ALGO_SEGLIST
    help
      Both allocators sit behind the same public API; exactly one is compiled.
      The fixed index macros VAIOS_HEAP_SEGLIST/TLSF and the selector
      VAIOS_HEAP_ALGO are built from this choice in vaios_config_derived.h and
      key the seglist.c / tlsf.c bodies.
config VAIOS_HEAP_ALGO_SEGLIST
    bool "Segregated fit (smallest, historical default)"
config VAIOS_HEAP_ALGO_TLSF
    bool "TLSF (O(1) worst-case malloc + free, bounded fragmentation)"
endchoice

config VAIOS_TASK_ARENA
    bool "Per-task private heap arena"
    default n
    help
      Phase 3, Stage 4: each task can carve a private heap arena from the kernel
      heap with v_task_arena_create(size). v_task_malloc/v_task_free then serve
      that task from its own arena only — no sharing, no kernel free-list walk.
      The arena is a contiguous owned region: the substrate the unprivileged flip
      (Stage 5) makes the task's sole writable heap under the MPU.
endmenu

menu "Memory protection (MPU)"
config VAIOS_MPU_ENABLE
    bool "Enable the ARMv7-M MPU (hardware memory protection)"
    default n
    help
      Program the MPU (via NavHAL hal_mpu) for hardware memory protection.
      Requires a target with an MPU (checked at runtime with hal_mpu_present);
      no effect on QEMU/host builds. Off until the region programming is
      Renode-validated. See docs/plan/MPU_CACHE_INTEGRATION_PLAN.md.
config VAIOS_MPU_STACK_GUARD
    bool "Per-task stack-overflow guard region"
    depends on VAIOS_MPU_ENABLE
    default y
    help
      Place a no-access MPU region at the low end of each task stack so an
      overflow traps into MemManage_Handler at the faulting store instead of
      silently corrupting the neighbouring block. The stack base is aligned to
      the guard size via v_memalign. Falls back to the software watermark on
      MPU-less targets.
config VAIOS_MPU_GUARD_SIZE
    int "Stack guard region size (bytes, power of two >= 32)"
    depends on VAIOS_MPU_STACK_GUARD
    default 32
config VAIOS_MPU_STATIC_PROTECT
    bool "Static kernel/peripheral protection (Phase 2)"
    depends on VAIOS_MPU_ENABLE
    default y
    help
      Phase 2: program a static background MPU map that bites even while tasks
      are still privileged (PRIVDEFENA's privileged default is otherwise RWX
      everywhere). Safe core: SRAM execute-never (W^X, catches execute-from-RAM)
      and peripherals privileged-only device+XN. The per-task stack guard moves
      to the top region so it still wins on overlap. On by default when the MPU
      is enabled (hardware fault-injection validated on the Nucleo-F401RE). See
      docs/plan/MPU_CACHE_INTEGRATION_PLAN.md Phase 2.
config VAIOS_MPU_FLASH_RO
    bool "Mark flash read-only (catch code/const corruption)"
    depends on VAIOS_MPU_STATIC_PROTECT
    default n
    help
      Add a read-only region over flash. HAZARD: on-chip flash programming
      writes the 0x08xxxxxx space directly, so this is incompatible with
      hal_flash's key/value store — enable only when the KV store is unused (or
      carve its sectors out via a subregion-disable mask).
config VAIOS_MPU_NULL_GUARD
    bool "NULL / low-alias no-access trap (catch NULL derefs)"
    depends on VAIOS_MPU_STATIC_PROTECT
    default y
    help
      Add a no-access region at [0, 1 MB) to trap NULL and near-NULL derefs.
      v_port_mpu_init relocates SCB->VTOR to the flash vector table (0x08000000)
      before arming this region, so exception vector fetches do not alias into
      it. Hardware-validated on the Nucleo-F401RE (boots with the guard armed; a
      NULL write traps with MMFSR DACCVIOL at addr 0x0).
endmenu

menu "Kernel/user separation (Phase 3)"
config VAIOS_SYSCALL_SVC
    bool "Route kernel entry through SVC syscalls"
    depends on VAIOS_MPU_ENABLE
    default n
    help
      Phase 3, Stage 1: generalise SVCall_Handler into a syscall dispatch and
      route selected kernel entry points (task_yield, task_delay) through
      `svc 1` instead of calling the kernel directly. Tasks stay PRIVILEGED, so
      this only validates the SVC mechanism/ABI (number in r12, args in r0-r3,
      negative-errno in r0) with zero isolation risk; the unprivileged flip and
      pointer validation land in later stages. Off by default.
config VAIOS_DEVFS
    bool "Everything-is-a-file device model (fd table + /dev)"
    depends on VAIOS_SYSCALL_SVC
    default n
    help
      Phase 3, Stage 2: a per-task file-descriptor table over a small object
      model (v_file_ops: read/write/close). Devices are /dev nodes backed by a
      driver op-table; open/read/write/close are syscalls. Wires /dev/console
      and routes printf() through write(). Kernel printk() stays a separate,
      direct, privileged path. Tasks stay privileged in this stage.
config VAIOS_MAX_FDS
    int "File descriptors per task"
    depends on VAIOS_DEVFS
    default 8
config VAIOS_IPC_FD
    bool "fd-typed IPC (named semaphores on the fd table)"
    depends on VAIOS_DEVFS
    default n
    help
      Phase 3, Stage 3: IPC objects live on the per-task fd table. A named
      semaphore is opened with v_sem_open("/sem/name", flags) -> a per-task fd;
      v_sem_take(fd)/v_sem_give(fd) are typed syscalls that resolve fd -> object;
      close(fd) drops the reference (object destroyed at refcount 0). This
      removes the raw kernel pointer from user handles and gives per-task
      capability isolation. The pointer-based v_semaphore_* API still exists.
endmenu

menu "IPC"
config MAX_SEMAPHORE_COUNT
