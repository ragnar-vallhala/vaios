/* vaios version. Generated by cmake/VaiosVersion.cmake from nav.toml's
 * [project].version, the only place the version is written down; do not edit.
 *
 * Part of the consumer interface (docs/consumer-interface.md). A consumer
 * built against a vaios whose major differs from what it was written for
 * should refuse to compile:
 *
 *   #include "vaios_version.h"
 *   #if VAIOS_VERSION_MAJOR != 0 || VAIOS_VERSION_MINOR < 2
 *   #error "needs vaios 0.2 or newer in the 0.x series"
 *   #endif
 */
#ifndef VAIOS_VERSION_H
#define VAIOS_VERSION_H

#define VAIOS_VERSION_MAJOR @VAIOS_VERSION_MAJOR@
#define VAIOS_VERSION_MINOR @VAIOS_VERSION_MINOR@
#define VAIOS_VERSION_PATCH @VAIOS_VERSION_PATCH@
#define VAIOS_VERSION "@VAIOS_VERSION@"
/* One comparable number: 0.2.2 -> 202. Each field is 0..99. */
#define VAIOS_VERSION_NUMBER \
    (VAIOS_VERSION_MAJOR * 10000 + VAIOS_VERSION_MINOR * 100 + VAIOS_VERSION_PATCH)

#endif /* VAIOS_VERSION_H */
