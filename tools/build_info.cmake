# Writes vaios_build.h: who built this image, from what, and when -- the build
# identity in the boot banner (kernel/vaios.c), like Linux's compile.h. Run as a
# target on EVERY build (kernel/CMakeLists.txt), not at configure time, so the
# revision and "-dirty" are the ones actually compiled rather than whatever the
# tree was when cmake last ran.
#
#   cmake -DOUT=<header> -DSRC=<repo root> -P build_info.cmake
execute_process(
  COMMAND git -C "${SRC}" describe --always --dirty --abbrev=7
  OUTPUT_VARIABLE rev OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT rev)
  set(rev "unknown")
endif()
string(TIMESTAMP when "%Y-%m-%d %H:%M:%S")
cmake_host_system_information(RESULT host QUERY HOSTNAME)
set(user "$ENV{USER}")
if(NOT user)
  set(user "unknown")
endif()
set(body "/* Generated by tools/build_info.cmake on every build. DO NOT EDIT. */
#define VAIOS_BUILD_REV \"${rev}\"
#define VAIOS_BUILD_TIME \"${when}\"
#define VAIOS_BUILD_BY \"${user}@${host}\"
")
# Rewrite only on a change, so an unchanged second-resolution stamp does not
# rebuild anything; in practice the time moves, and one file recompiles.
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT "${old}" STREQUAL "${body}")
  file(WRITE "${OUT}" "${body}")
endif()
